{
  "manifest_version": 3,
  "name": "YouTube Shorts Redirect",
  "author": "huantian",
  "version": "1.0.1",

  "description": "Redirect YouTube Shorts URLs to normal video URLs.",

  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["redirect.js"],
      "run_at": "document_start"
    }
  ],

  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "huantian@youtube-shorts-redirect",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "159.0"
    }
  }
}

